<Window x:Class="OfflineReShade.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Offline ReShade"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel Background="#F4F5F7">
    <Border DockPanel.Dock="Top" Background="#20242B" Padding="18,12">
      <DockPanel>
        <TextBlock Text="Offline ReShade" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#C9D1D9" VerticalAlignment="Center" Text="Ready" />
      </DockPanel>
    </Border>

    <Grid Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="420" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#D8DDE6" BorderThickness="1" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Inputs" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

            <TextBlock Text="Color PNG" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Width="34" Content="..." Click="BrowseColorClick" />
              <TextBox x:Name="ColorPathBox" Margin="0,0,6,0" />
            </DockPanel>

            <TextBlock Text="Depth PNG" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Width="34" Content="..." Click="BrowseDepthClick" />
              <TextBox x:Name="DepthPathBox" Margin="0,0,6,0" />
            </DockPanel>

            <TextBlock Text="Effect Folder" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Width="34" Content="..." Click="BrowseEffectClick" />
              <TextBox x:Name="EffectDirBox" Margin="0,0,6,0" />
            </DockPanel>

            <TextBlock Text="Preset INI" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Width="34" Content="..." Click="BrowsePresetClick" />
              <TextBox x:Name="PresetPathBox" Margin="0,0,6,0" />
            </DockPanel>

            <TextBlock Text="Output PNG" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,14">
              <Button DockPanel.Dock="Right" Width="34" Content="..." Click="BrowseOutputClick" />
              <TextBox x:Name="OutputPathBox" Margin="0,0,6,0" />
            </DockPanel>

            <TextBlock Text="Render Size" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,4" />
            <TextBlock Text="Leave blank to use the color PNG size." Foreground="#5B6472" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="420" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Width" Margin="0,0,0,4" />
                <TextBox x:Name="WidthBox" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Height" Margin="0,0,0,4" />
                <TextBox x:Name="HeightBox" />
              </StackPanel>
            </Grid>

            <WrapPanel Margin="0,0,0,14">
              <Button x:Name="StartPreviewButton" Width="104" Height="32" Margin="0,0,8,8" Content="Start Preview" Click="StartPreviewClick" />
              <Button x:Name="StopPreviewButton" Width="104" Height="32" Margin="0,0,8,8" Content="Stop" Click="StopPreviewClick" IsEnabled="False" />
              <Button x:Name="SaveButton" Width="104" Height="32" Margin="0,0,8,8" Content="Save PNG" Click="SavePngClick" />
              <Button Width="104" Height="32" Margin="0,0,8,8" Content="ReShade Shot" Click="ReShadeScreenshotClick" />
              <Button Width="104" Height="32" Margin="0,0,8,8" Content="Open Output" Click="OpenOutputClick" />
              <Button Width="104" Height="32" Margin="0,0,8,8" Content="Refresh" Click="RefreshOutputClick" />
            </WrapPanel>

            <TextBlock Text="Log" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,8" />
            <TextBox x:Name="LogBox" Height="210" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#D8DDE6" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FAFBFC" Padding="12,8">
            <TextBlock Text="ReShade Controls" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <Border Grid.Row="1" Background="#15171B">
            <wfi:WindowsFormsHost x:Name="OverlayHost">
              <wf:Panel x:Name="OverlayPanel" BackColor="#15171B" />
            </wfi:WindowsFormsHost>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="4" Background="White" BorderBrush="#D8DDE6" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FAFBFC" Padding="12,8">
            <TextBlock x:Name="PreviewInfoText" Text="Embedded ReShade Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <Border Grid.Row="1" Background="#15171B">
            <wfi:WindowsFormsHost x:Name="PreviewHost">
              <wf:Panel x:Name="PreviewPanel" BackColor="Black" />
            </wfi:WindowsFormsHost>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>





