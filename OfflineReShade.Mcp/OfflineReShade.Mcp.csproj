<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../maintenance/OfflineVersion.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OfflineReShade.Mcp</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../OfflineReShade.Core/OfflineReShade.Core.csproj" /></ItemGroup>
  <!-- docs/AGENT_GUIDE.md is both the published doc and the MCP resource offline-reshade://guide/agent. -->
  <ItemGroup><EmbeddedResource Include="../docs/AGENT_GUIDE.md" LogicalName="OfflineReShade.Mcp.AgentGuide.md" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>
</Project>
