<Window
    x:Class="OfflineReShade.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OfflineReShade.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="Offline ReShade">

  <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="16,10" Background="#20242B">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Offline ReShade" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,10,0" />
        <Button Content="Start Preview" Command="{x:Bind ViewModel.StartPreviewCommand}" />
        <Button Content="Stop" Command="{x:Bind ViewModel.StopPreviewCommand}" />
        <Button Content="ReShade Shot" Command="{x:Bind ViewModel.ReShadeShotCommand}" />
        <Button Content="Save PNG" Command="{x:Bind ViewModel.SavePngCommand}" />
        <Button Content="Reload" Command="{x:Bind ViewModel.ReloadCommand}" />
        <Button Content="Save Preset" Command="{x:Bind ViewModel.SavePresetCommand}" />
        <Button Content="Settings" Command="{x:Bind ViewModel.ToggleSettingsCommand}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Grid ColumnSpacing="8" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Real Time" Foreground="#C9D1D9" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="InputModeSwitch"
                        Grid.Column="1"
                        Width="52"
                        MinWidth="0"
                        OffContent=""
                        OnContent=""
                        Toggled="OnInputModeSwitchToggled" />
          <TextBlock Grid.Column="2" Text="Gallery" Foreground="#C9D1D9" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.FpsText, Mode=OneWay}" Foreground="#C9D1D9" />
        <TextBlock Text="{x:Bind ViewModel.ControlStatusText, Mode=OneWay}" Foreground="#C9D1D9" />
        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer x:Name="SettingsContent"
                    Visibility="Collapsed"
                    Padding="18"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border MaxWidth="760"
                HorizontalAlignment="Left"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />

            <TextBlock Text="Game" />
            <ComboBox x:Name="DepthProfileBox"
                      MinWidth="180"
                      SelectionChanged="OnDepthProfileSelectionChanged">
              <ComboBoxItem Content="Koikatsu Sunshine (KKS)" Tag="kks" />
              <ComboBoxItem Content="Koikatsu (KK)" Tag="kk" />
            </ComboBox>

            <TextBlock Text="Color PNG" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.ColorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickColorCommand}" />
            </Grid>

            <TextBlock Text="Depth Encoding" />
            <ComboBox x:Name="DepthFormatBox"
                      MinWidth="240"
                      SelectionChanged="OnDepthFormatSelectionChanged">
              <ComboBoxItem Content="Raw Float32 device depth (.rfloat)" Tag="raw" />
              <ComboBoxItem Content="RGBA8 packed device depth PNG" Tag="rgba" />
            </ComboBox>

            <TextBlock Text="Depth Downsample Filter" />
            <ComboBox x:Name="DepthDownsampleBox"
                      MinWidth="180"
                      SelectionChanged="OnDepthDownsampleSelectionChanged">
              <ComboBoxItem Content="Max 2x2" Tag="max2x2" />
              <ComboBoxItem Content="Smooth Box 2x2" Tag="box" />
            </ComboBox>

            <TextBlock Text="Depth File" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.DepthPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickDepthCommand}" />
            </Grid>

            <TextBlock Text="Effect Folder" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.EffectDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickEffectDirCommand}" />
            </Grid>

            <TextBlock Text="Preset INI" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.PresetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickPresetCommand}" />
            </Grid>

            <TextBlock Text="Output PNG" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickOutputCommand}" />
            </Grid>

            <TextBlock Text="Gallery" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="Gallery Input Folder" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.GalleryInputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickGalleryInputFolderCommand}" />
            </Grid>

            <TextBlock Text="Gallery Output Folder" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.GalleryOutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickGalleryOutputFolderCommand}" />
            </Grid>

            <TextBlock Text="Render Size" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="Leave blank to use the color PNG size." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="Width" />
                <TextBox Text="{x:Bind ViewModel.Settings.RenderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Height" />
                <TextBox Text="{x:Bind ViewModel.Settings.RenderHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="Preview Transport" />
            <ComboBox x:Name="PreviewTransportBox"
                      MinWidth="180"
                      SelectionChanged="OnPreviewTransportSelectionChanged">
              <ComboBoxItem Content="GPU" Tag="GPU" />
              <ComboBoxItem Content="CPU" Tag="CPU" />
            </ComboBox>
            <ToggleSwitch Header="Show FPS"
                          IsOn="{x:Bind ViewModel.Settings.ShowFps, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <Grid x:Name="MainContent" Padding="14" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="430" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="GalleryColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="ReShade Controls" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ControlStatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TabView x:Name="ControlsTabView"
                     Grid.Row="1"
                     IsAddTabButtonVisible="False"
                     CanDragTabs="False"
                     TabWidthMode="Equal"
                     SelectionChanged="OnControlsTabSelectionChanged">
              <TabViewItem Header="FX">
                <ScrollViewer x:Name="ControlsScrollViewer"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Padding="12" Spacing="12">
                    <StackPanel x:Name="ControlsPanel" Spacing="10" />
                    <Expander Header="Log" IsExpanded="False">
                      <TextBox Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               MinHeight="180" />
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabViewItem>
              <TabViewItem Header="Add-ons">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Padding="12"
                              Spacing="10">
                    <Border Height="280"
                            Background="Black"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                      <Grid x:Name="AddonNativeSurface">
                        <TextBlock Text="Native add-on panel"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <StackPanel x:Name="AddonsPanel"
                                Spacing="10" />
                    <Expander Header="WinUI Add-on Controls"
                              IsExpanded="True">
                      <StackPanel x:Name="AddonControlsPanel"
                                  Spacing="10" />
                    </Expander>
                    <Expander Header="ImGui Capture Debug"
                              IsExpanded="True">
                      <TextBox Text="{x:Bind ViewModel.AddonDebugText, Mode=OneWay}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               TextWrapping="NoWrap"
                               FontFamily="Consolas"
                               MinHeight="260" />
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabViewItem>
            </TabView>
          </Grid>
        </Border>

        <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="#15171B">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
              <TextBlock Text="{x:Bind ViewModel.PreviewInfoText, Mode=OneWay}" FontWeight="SemiBold" />
            </Grid>
            <Grid x:Name="PreviewSurface" Grid.Row="1" Background="Black">
              <SwapChainPanel x:Name="PreviewSwapChainPanel" Visibility="Collapsed" />
              <Image x:Name="PreviewImage" Stretch="Uniform">
                <Image.RenderTransform>
                  <CompositeTransform x:Name="PreviewTransform" />
                </Image.RenderTransform>
              </Image>
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="GalleryPanel"
                Grid.Column="2"
                Visibility="Collapsed"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="GalleryTitle" Text="Gallery" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      MinWidth="34"
                      Padding="8,4"
                      Content="&#xE70D;"
                      FontFamily="Segoe MDL2 Assets"
                      Command="{x:Bind ViewModel.ToggleGalleryPanelCommand}" />
            </Grid>

            <Grid x:Name="GalleryExpandedContent" Grid.Row="1" RowSpacing="10" Padding="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Button Content="Refresh" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RefreshGalleryCommand}" />
              <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Button Content="Batch Save"
                          HorizontalAlignment="Stretch"
                          Command="{x:Bind ViewModel.BatchApplySavePngCommand}" />
                  <Button Grid.Row="1"
                          Content="Batch Shot"
                          HorizontalAlignment="Stretch"
                          Command="{x:Bind ViewModel.BatchApplyReShadeShotCommand}" />
                </Grid>
                <TextBox Grid.Column="1"
                         Header="Frame Delay"
                         Text="{x:Bind ViewModel.Settings.GalleryBatchFrameDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         InputScope="Number" />
              </Grid>
              <ListView x:Name="GalleryList"
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.GalleryItems, Mode=OneWay}"
                        SelectionChanged="OnGallerySelectionChanged"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:GalleryItemViewModel">
                    <Grid ColumnSpacing="10" Padding="4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="96" Height="54" Background="Black">
                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind BaseName}" TextWrapping="WrapWholeWords" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind StatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
