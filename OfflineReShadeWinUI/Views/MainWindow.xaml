<Window
    x:Class="OfflineReShade.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OfflineReShade.WinUI.ViewModels"
    xmlns:views="using:OfflineReShade.WinUI.Views"
    mc:Ignorable="d"
    Title="Offline ReShade">

  <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="16,10" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <CommandBar Grid.ColumnSpan="3" DefaultLabelPosition="Right" IsOpen="False" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <AppBarButton Label="Open image" Icon="OpenFile" Command="{x:Bind ViewModel.OpenImageCommand}" AutomationProperties.AutomationId="OpenImage"  />
        <AppBarButton Label="Listen for game output" Icon="Play" Command="{x:Bind ViewModel.ConfigureListenerCommand}" AutomationProperties.AutomationId="ConfigureInputListener"  />
        <AppBarButton Label="Export image" Icon="Save" Command="{x:Bind ViewModel.OpenExportCommand}" AutomationProperties.AutomationId="ExportImage"  />
        <AppBarButton Label="Undo" Icon="Undo" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo FX edit (Ctrl+Z)" AutomationProperties.AutomationId="UndoEdit"  />
        <AppBarButton Label="Redo" Icon="Redo" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo FX edit (Ctrl+Y)" AutomationProperties.AutomationId="RedoEdit"  />
        <CommandBar.SecondaryCommands>
          <AppBarButton Label="Keyboard shortcuts" AutomationProperties.AutomationId="KeyboardShortcuts">
            <AppBarButton.Flyout><Flyout>
              <TextBlock Text="Ctrl+O: Open image&#10;Ctrl+E: Export image&#10;Ctrl+S: Save preset&#10;Ctrl+Z / Ctrl+Y: Undo / redo&#10;Ctrl+F: Search effects&#10;Ctrl+0 / Ctrl+1: Fit / 100%&#10;Ctrl+B: Original / processed preview&#10;Canvas arrows: Pan&#10;L: Toggle logarithmic sliders&#10;Drag + wheel: Slider sensitivity&#10;Text fields retain their normal editing shortcuts." TextWrapping="Wrap" MaxWidth="320" />
            </Flyout></AppBarButton.Flyout>
          </AppBarButton>
          <AppBarButton Label="Show or hide effects" Click="OnToggleEffects" AutomationProperties.AutomationId="ToggleEffects"  />
          <AppBarButton Label="Show or hide gallery" Command="{x:Bind ViewModel.ToggleGalleryPanelCommand}" AutomationProperties.AutomationId="ToggleGallery"  />
          <AppBarButton Label="Input and preset" Command="{x:Bind ViewModel.OpenInputPanelCommand}"  AutomationProperties.AutomationId="MainWindowControl8" />
          <AppBarButton Label="Stop renderer" Command="{x:Bind ViewModel.StopPreviewCommand}"  AutomationProperties.AutomationId="MainWindowControl9" />
          <AppBarButton Label="Reload effects" Command="{x:Bind ViewModel.ReloadCommand}"  AutomationProperties.AutomationId="MainWindowControl10" />
          <AppBarButton Label="Save preset" Command="{x:Bind ViewModel.SavePresetCommand}"  AutomationProperties.AutomationId="MainWindowControl11" />
          <AppBarButton Label="Save preset as…" Command="{x:Bind ViewModel.SavePresetAsCommand}" AutomationProperties.AutomationId="SavePresetAs"  />
          <AppBarButton Label="Restore controls from renderer" Command="{x:Bind ViewModel.RestoreControlsCommand}" ToolTipService.ToolTip="Discard failed pending control edits and display actual renderer values"  AutomationProperties.AutomationId="MainWindowControl13" />
          <AppBarButton Label="Settings" Icon="Setting" Command="{x:Bind ViewModel.ToggleSettingsCommand}"  AutomationProperties.AutomationId="MainWindowControl14" />
        </CommandBar.SecondaryCommands>

      </CommandBar>

      <ProgressBar Grid.Row="1"
                   Grid.ColumnSpan="3"
                   Height="3"
                   Margin="0,8,0,0"
                   IsIndeterminate="{x:Bind ViewModel.IsEffectsLoading, Mode=OneWay}"
                   Opacity="{x:Bind ViewModel.EffectsLoadingOpacity, Mode=OneWay}"
                   AutomationProperties.Name="ReShade effect compilation progress" />
      <Button Grid.Row="1" Grid.Column="2" Content="Cancel operation" HorizontalAlignment="Right" Margin="8,4,0,0"
              Command="{x:Bind ViewModel.CancelOperationCommand}" AutomationProperties.AutomationId="CancelOperation"
              Visibility="{x:Bind views:MainWindow.BoolVisibility(ViewModel.IsOperationRunning), Mode=OneWay}"  />
      <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnSpacing="12" Margin="0,8,0,0" Visibility="{x:Bind views:MainWindow.BoolVisibility(ViewModel.HasBatchTask), Mode=OneWay}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ProgressBar Value="{x:Bind ViewModel.BatchProgress, Mode=OneWay}" Maximum="{x:Bind ViewModel.BatchMaximum, Mode=OneWay}"
                     AutomationProperties.Name="Batch export progress" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BatchStatusText, Mode=OneWay}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="Cancel batch" Command="{x:Bind ViewModel.CancelBatchCommand}" AutomationProperties.AutomationId="CancelBatch"  />
      </Grid>
      <InfoBar Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0"
               IsOpen="{x:Bind ViewModel.FeedbackOpen, Mode=TwoWay}"
               Severity="{x:Bind views:MainWindow.NoticeSeverity(ViewModel.FeedbackStatus), Mode=OneWay}"
               Title="{x:Bind ViewModel.FeedbackTitle, Mode=OneWay}" Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
               AutomationProperties.AutomationId="OperationFeedback" AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Retry" AutomationProperties.AutomationId="RetryOperation" Command="{x:Bind ViewModel.RetryOperationCommand}" Visibility="{x:Bind views:MainWindow.BoolVisibility(ViewModel.CanRetryOperation), Mode=OneWay}"  />
          <Button Content="Locate files" AutomationProperties.AutomationId="LocateOperationFiles" Command="{x:Bind ViewModel.LocateFeedbackCommand}"  />
          <Button Content="Details" AutomationProperties.AutomationId="OperationDetails">
            <Button.Flyout>
              <Flyout>
                <ScrollViewer MaxHeight="360" MaxWidth="640">
                  <TextBox Header="Operation details" AutomationProperties.AutomationId="OperationDetailsText" Text="{x:Bind ViewModel.FeedbackDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinWidth="300"  />
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </InfoBar>
    </Grid>

    <ContentControl x:Name="InputHost" Grid.Row="1" HorizontalContentAlignment="Stretch" />

    <Grid Grid.Row="2">
      <ScrollViewer x:Name="SettingsContent" IsEnabled="{x:Bind ViewModel.CanEditSession, Mode=OneWay}"
                    Visibility="Collapsed"
                    Padding="18"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border MaxWidth="760"
                HorizontalAlignment="Left"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
            <TextBox Header="MCP session ID" Text="{x:Bind ViewModel.AutomationSessionId, Mode=OneWay}" IsReadOnly="True"
                     AutomationProperties.AutomationId="AutomationSessionId"  />

            <TextBlock Text="Effect Folder" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.EffectDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.AutomationId="MainWindowControl23" AutomationProperties.Name="Effects folder" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickEffectDirCommand}"  AutomationProperties.AutomationId="MainWindowControl24" AutomationProperties.Name="Choose effects folder" />
            </Grid>

            <TextBlock Text="Gallery" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="Gallery Input Folder" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.GalleryInputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.AutomationId="MainWindowControl25" AutomationProperties.Name="Gallery input folder" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickGalleryInputFolderCommand}"  AutomationProperties.AutomationId="MainWindowControl26" AutomationProperties.Name="Choose gallery input folder" />
            </Grid>

            <TextBlock Text="Gallery Output Folder" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{x:Bind ViewModel.Settings.GalleryOutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.AutomationId="MainWindowControl27" AutomationProperties.Name="Gallery output folder" />
              <Button Grid.Column="1" Content="..." Command="{x:Bind ViewModel.PickGalleryOutputFolderCommand}"  AutomationProperties.AutomationId="MainWindowControl28" AutomationProperties.Name="Choose gallery output folder" />
            </Grid>

            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnThemeSelectionChanged" AutomationProperties.AutomationId="ThemePreference">
              <ComboBoxItem Content="Use Windows setting" Tag="System" />
              <ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>
            <TextBlock Text="Preview Transport" />
            <ComboBox x:Name="PreviewTransportBox"
                      MinWidth="180"
                      SelectionChanged="OnPreviewTransportSelectionChanged" AutomationProperties.AutomationId="MainWindowControl30">
              <ComboBoxItem Content="GPU" Tag="GPU" />
              <ComboBoxItem Content="CPU" Tag="CPU" />
            </ComboBox>
            <ToggleSwitch Header="Show FPS"
                          IsOn="{x:Bind ViewModel.Settings.ShowFps, Mode=TwoWay}"  AutomationProperties.AutomationId="MainWindowControl31" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <Grid x:Name="MainContent" Padding="12" SizeChanged="OnWorkspaceSizeChanged">
        <SplitView x:Name="GallerySplit" PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="280" IsPaneOpen="{x:Bind ViewModel.IsGalleryPanelOpen, Mode=TwoWay}">
          <SplitView.Pane>
        <Border x:Name="GalleryPanel"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="GalleryTitle" Text="Gallery" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      MinWidth="34"
                      Padding="8,4"
                      AutomationProperties.Name="Hide gallery" AutomationProperties.AutomationId="HideGallery"
                      Content="&#xE70D;"
                      FontFamily="Segoe MDL2 Assets"
                      Command="{x:Bind ViewModel.ToggleGalleryPanelCommand}"  />
            </Grid>

            <Grid x:Name="GalleryExpandedContent" Grid.Row="1" RowSpacing="10" Padding="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Button Content="Refresh" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RefreshGalleryCommand}"  AutomationProperties.AutomationId="MainWindowControl33" />
              <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Button Content="Batch Save"
                          HorizontalAlignment="Stretch"
                          Command="{x:Bind ViewModel.BatchApplySavePngCommand}"  AutomationProperties.AutomationId="MainWindowControl34" />
                  <Button Grid.Row="1"
                          Content="Batch Shot"
                          HorizontalAlignment="Stretch"
                          Command="{x:Bind ViewModel.BatchApplyReShadeShotCommand}"  AutomationProperties.AutomationId="MainWindowControl35" />
                </Grid>
                <TextBox Grid.Column="1"
                         Header="Warmup frames" IsEnabled="{x:Bind ViewModel.CanEditSession, Mode=OneWay}"
                         Text="{x:Bind ViewModel.Settings.GalleryBatchFrameDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         InputScope="Number"  AutomationProperties.AutomationId="MainWindowControl36" AutomationProperties.Name="Warmup frames" />
              </Grid>
              <ListView x:Name="GalleryList" IsEnabled="{x:Bind ViewModel.CanEditSession, Mode=OneWay}"
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.GalleryItems, Mode=OneWay}"
                        SelectionChanged="OnGallerySelectionChanged"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="MainWindowControl37">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:GalleryItemViewModel">
                    <Grid ColumnSpacing="10" Padding="4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="96" Height="54" Background="Black">
                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind BaseName}" TextWrapping="WrapWholeWords" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind StatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </Border>
          </SplitView.Pane>
          <SplitView x:Name="EffectsSplit" DisplayMode="Inline" OpenPaneLength="400" IsPaneOpen="{x:Bind ViewModel.Settings.EffectsPaneOpen, Mode=TwoWay}">
            <SplitView.Pane><ContentControl x:Name="EffectsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></SplitView.Pane>
            <ContentControl x:Name="CanvasHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </SplitView>
        </SplitView>
      </Grid>
    </Grid>

    <Grid x:Name="SliderModeOverlay"
          Grid.RowSpan="2"
          Canvas.ZIndex="1000"
          Visibility="Collapsed"
          IsHitTestVisible="False"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <Border Padding="22,12"
              MinWidth="116"
              HorizontalAlignment="Center"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <TextBlock x:Name="SliderModeOverlayText"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="26"
                   FontWeight="SemiBold" />
      </Border>
    </Grid>
  </Grid>
</Window>
