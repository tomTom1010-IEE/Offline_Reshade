<UserControl
    x:Class="OfflineReShade.WinUI.Views.ExportPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OfflineReShade.WinUI.Views">
  <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" MinWidth="320" MaxWidth="560">
      <TextBlock Text="Image to export" Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBlock Text="{x:Bind ViewModel.ExportSourceText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ExportSource" />
      <TextBlock Text="{x:Bind ViewModel.ExportConfigurationText, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.ExportDimensionsText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="ExportDimensions" />
      <TextBox Header="Destination PNG" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
               AutomationProperties.AutomationId="ExportDestination" AutomationProperties.Name="Destination PNG" />
      <Button Content="Choose destination folder" Command="{x:Bind ViewModel.PickExportFolderCommand}" AutomationProperties.AutomationId="ChooseExportFolder" />
      <RadioButtons Header="If the file already exists" SelectedIndex="{x:Bind ViewModel.ExportConflictIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                    AutomationProperties.AutomationId="ExportConflictPolicy" AutomationProperties.Name="File conflict policy">
        <RadioButton Content="Save with a numbered filename" AutomationProperties.AutomationId="ExportRename" />
        <RadioButton Content="Replace after successful export" AutomationProperties.AutomationId="ExportReplace" />
        <RadioButton Content="Stop and report a conflict" AutomationProperties.AutomationId="ExportFailOnConflict" />
      </RadioButtons>
      <Expander Header="Advanced export options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" AutomationProperties.AutomationId="ExportAdvanced">
        <StackPanel Spacing="12">
          <ToggleSwitch Header="Capture method" OffContent="ReShade screenshot (default)" OnContent="Direct PNG"
                        IsOn="{x:Bind ViewModel.ExportDirectPng, Mode=TwoWay}" AutomationProperties.AutomationId="ExportDirectPng" AutomationProperties.Name="Use direct PNG instead of ReShade screenshot" />
          <TextBlock Text="ReShade screenshot triggers screenshot add-on events. Direct PNG saves the rendered image without those events. Both exclude the interface; a failure never switches methods automatically." TextWrapping="Wrap" />
          <TextBox Header="Warmup frames" Text="{x:Bind ViewModel.ExportWarmup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="ExportWarmup" AutomationProperties.Name="Warmup frames" InputScope="Number" />
          <TextBlock Text="Frames rendered after compilation and the latest changes. Increase for effects that accumulate samples over time." TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
      <ProgressBar IsIndeterminate="True" Visibility="{x:Bind views:MainWindow.BoolVisibility(ViewModel.Exporting), Mode=OneWay}" AutomationProperties.Name="Export in progress" />
      <Button Content="Cancel operation" Command="{x:Bind ViewModel.CancelOperationCommand}" Visibility="{x:Bind views:MainWindow.BoolVisibility(ViewModel.Exporting), Mode=OneWay}" AutomationProperties.AutomationId="CancelExport" />
      <InfoBar IsOpen="{x:Bind ViewModel.FeedbackOpen, Mode=TwoWay}" IsClosable="True"
               Severity="{x:Bind views:MainWindow.NoticeSeverity(ViewModel.FeedbackStatus), Mode=OneWay}" Title="{x:Bind ViewModel.FeedbackTitle, Mode=OneWay}"
               Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" AutomationProperties.AutomationId="ExportFeedback" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Spacing="8" Visibility="{x:Bind views:MainWindow.BoolVisibility(ViewModel.HasExportedImage), Mode=OneWay}">
        <TextBlock Text="Last successful export" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.ExportedPath, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ExportedPath" AutomationProperties.LiveSetting="Polite" />
        <Button Content="Open exported image" Command="{x:Bind ViewModel.OpenExportedImageCommand}" AutomationProperties.AutomationId="OpenExportedImage" />
        <Button Content="Show in folder" Command="{x:Bind ViewModel.LocateExportedImageCommand}" AutomationProperties.AutomationId="LocateExportedImage" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
