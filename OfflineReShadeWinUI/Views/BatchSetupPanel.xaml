<UserControl x:Class="OfflineReShade.WinUI.Views.BatchSetupPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:OfflineReShade.WinUI.ViewModels">
 <Grid MinWidth="320" MaxWidth="640" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer MaxHeight="260">
   <StackPanel Spacing="12">
    <ToggleSwitch Header="Range" OnContent="Selected images" OffContent="All images" IsOn="{x:Bind ViewModel.SelectedOnly, Mode=TwoWay}" AutomationProperties.AutomationId="BatchRange"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Header="Output directory" Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BatchOutputDirectory"/>
     <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolder" VerticalAlignment="Bottom" AutomationProperties.AutomationId="BatchBrowseDirectory"/>
    </Grid>
    <TextBox Header="Filename suffix (optional)" Text="{x:Bind ViewModel.Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BatchSuffix"/>
    <ComboBox Header="Existing files" ItemsSource="{x:Bind ViewModel.Policies}" SelectedIndex="{x:Bind ViewModel.PolicyIndex, Mode=TwoWay}" AutomationProperties.AutomationId="BatchConflictPolicy"/>
    <CheckBox Content="Reuse outputs only after fingerprint and file verification" IsChecked="{x:Bind ViewModel.Resume, Mode=TwoWay}" AutomationProperties.AutomationId="BatchReuse"/>
    <Expander Header="Advanced export options" IsExpanded="False" AutomationProperties.AutomationId="BatchAdvanced">
     <StackPanel Spacing="8">
      <CheckBox Content="ReShade screenshot compatibility (recommended)" IsChecked="{x:Bind ViewModel.ReShadeShot, Mode=TwoWay}" AutomationProperties.AutomationId="BatchScreenshotCompatibility"/>
      <TextBlock Text="Enabled: notify screenshot Add-ons. Disabled: direct PNG export. Both use the final output resolution." TextWrapping="Wrap"/>
      <TextBox Header="Warmup frames" Text="{x:Bind ViewModel.Frames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" AutomationProperties.AutomationId="BatchWarmup"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Candidates}" SelectionMode="None" IsEnabled="{x:Bind ViewModel.SelectedOnly, Mode=OneWay}" AutomationProperties.Name="Images available for batch selection" AutomationProperties.AutomationId="BatchCandidates">
   <ListView.ItemTemplate><DataTemplate x:DataType="vm:BatchCandidateViewModel">
    <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AutomationId="BatchCandidate">
     <StackPanel><TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </CheckBox>
   </DataTemplate></ListView.ItemTemplate>
  </ListView>
  <StackPanel Grid.Row="2" Spacing="8">
   <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="FailureText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <Expander Header="Review paths and validation details" AutomationProperties.AutomationId="BatchPreflightDetails">
    <ScrollViewer MaxHeight="140"><TextBlock Text="{x:Bind ViewModel.Details, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
   </Expander>
  </StackPanel>
 </Grid>
</UserControl>
